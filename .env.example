# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your real keys never get committed.
# Never put real keys in this file: it is public.

# DSAIC AI inference server (OpenAI-compatible API).
# Ask Saad for the server address and your project key.
FINANCE_AGENT_LLM_URL=http://SERVER_ADDRESS:4000/v1
FINANCE_AGENT_LLM_KEY=replace-with-your-key
FINANCE_AGENT_LLM_MODEL=club-default
